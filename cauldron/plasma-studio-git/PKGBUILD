# Maintainer: Fabio 'Lolix' Loli <fabio.loli@disroot.org> -> https://github.com/FabioLolix

pkgname=plasma-studio-git
pkgver=r1887.931c24c4
pkgrel=1
pkgdesc="Multimedia handling application that features video editing capabilities, raw photo editing, vector graphics, animations, audio editing, recording and streaming, and 3D modeling"
arch=(x86_64)
url="https://invent.kde.org/niccolove/plasma-studio"
license=(GPL-2.0-or-later)
depends=(
    ffmpeg
    glib2
    glibc
    hicolor-icon-theme
    kconfigwidgets
    ki18n
    kiconthemes
    kirigami
    kirigami-addons
    libgcc
    libglvnd
    libraw
    libsecret
    libstdc++
    libva
    mpv
    qt6-base
    qt6-declarative
    qt6-multimedia
    qt6-quick3d
    wayland
    zlib
    )
makedepends=(
    chrpath
    cmake
    git
    vulkan-headers
    )
provides=(plasma-studio)
conflicts=(plasma-studio)
options=()
source=("git+https://invent.kde.org/niccolove/plasma-studio.git")
sha256sums=('SKIP')

pkgver() {
  cd "plasma-studio"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  # Disable warning Detected locale "C" with character encoding "ANSI_X3.4-1968", which is not UTF-8.
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8

  local _flags=(

  )

  cmake -B build -S "plasma-studio" -Wno-author \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    "${_flags[@]}"

  cmake --build build
}

#check() {
#  ctest --test-dir build --output-on-failure
#}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # remove Insecure RUNPATH
  chrpath --delete "${pkgdir}"/usr/lib/qt6/qml/Studio/libstudiopluginplugin.so
}
